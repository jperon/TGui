-- tests/test_typed_query_permissions.moon
-- Typed space queries generated by graphql/dynamic.moon must enforce the read
-- permission: no token -> Unauthorized, authenticated without grant -> Forbidden,
-- and an FK / back-reference to a space the user cannot read must not leak it.

R         = require 'tests.runner'
auth      = require 'core.auth'
perms_mod = require 'core.permissions'
spaces_mod = require 'core.spaces'
executor  = require 'graphql.executor'
dynamic   = require 'graphql.dynamic'
json      = require 'json'

SUFFIX = tostring math.random 100000, 999999

SRC_NAME = "tqp_src_#{SUFFIX}"
TGT_NAME = "tqp_tgt_#{SUFFIX}"

-- ── Fixture: two spaces, one relation, one record each ───────────────────────

src_sp = spaces_mod.create_user_space SRC_NAME, "typed query permissions — source"
tgt_sp = spaces_mod.create_user_space TGT_NAME, "typed query permissions — target"
src_id = src_sp.id
tgt_id = tgt_sp.id

spaces_mod.add_field src_id, 'label', 'String'
src_fk  = spaces_mod.add_field src_id, 'tgt_id', 'Int'
tgt_seq = spaces_mod.add_field tgt_id, 'ref_id', 'Sequence'
spaces_mod.add_field tgt_id, 'nom', 'String'

rel_id = tostring require('uuid').new!
box.space._tdb_relations\insert { rel_id, src_id, src_fk.id, tgt_id, tgt_seq.id, 'link_to_tgt' }

box.space["data_#{SRC_NAME}"]\insert { 'tqp-src-1', json.encode { label: 'src-row', tgt_id: 1 } }
box.space["data_#{TGT_NAME}"]\insert { 'tqp-tgt-1', json.encode { ref_id: 1, nom: 'secret-target' } }

-- Rebuild the schema so both typed queries exist (tests/test_batch_ops.moon:25).
require('resolvers.init').reinit!

SRC_T = dynamic.gql_name SRC_NAME
TGT_T = dynamic.gql_name TGT_NAME

-- ── Actors ───────────────────────────────────────────────────────────────────

-- A real user with a live session token (ctx carries user_id AND token).
make_user = (prefix) ->
  user = auth.create_user "#{prefix}_#{SUFFIX}", "#{prefix}_#{SUFFIX}@test.local", "pass1234"
  sess = auth.create_session user.id
  { user: user, token: sess.token }

ctx_of = (a) -> { user_id: a.user.id, token: a.token }

grant_read = (user, resource_id) ->
  grp = perms_mod.create_group "tqg_#{user.username}_#{SUFFIX}", ''
  perms_mod.grant grp.id, 'space', resource_id, 'read'
  perms_mod.add_member user.id, grp.id
  grp

-- (b) authenticated user with a session, no group at all
actor_none = make_user 'tqnone'
-- (c) read on the source space only
actor_src = make_user 'tqsrc'
grp_src = grant_read actor_src.user, src_id
-- (e) read on the target space only
actor_tgt = make_user 'tqtgt'
grp_tgt = grant_read actor_tgt.user, tgt_id
-- (d) member of the built-in admin group
admin_user = auth.get_user_by_username 'admin'
admin_sess = auth.create_session admin_user.id
admin_ctx  = { user_id: admin_user.id, token: admin_sess.token }

-- ── Helpers ──────────────────────────────────────────────────────────────────

run_q = (query, ctx) -> executor.execute { query: query, context: ctx }

has_error = (res, pattern) ->
  return false unless res.errors
  for e in *res.errors
    return true if tostring(e.message)\find pattern
  false

errs_json = (res) -> json.encode(res.errors or {})

-- True when the response payload contains a forbidden needle (plain search).
leaks = (res, needle) ->
  encoded = json.encode res.data
  encoded\find(needle, 1, true) != nil

-- ── Tests ────────────────────────────────────────────────────────────────────

R.describe "Typed space queries — read permission", ->
  R.it "fixture: rebuilt schema exposes the typed queries", ->
    res = run_q "{ #{SRC_T} { items { label } } }", admin_ctx
    R.nok res.errors, "typed query must exist: #{errs_json res}"
    R.eq #res.data[SRC_T].items, 1
    R.eq res.data[SRC_T].items[1].label, 'src-row'

  R.it "ctx = {} (no token) -> Unauthorized, no data", ->
    res = run_q "{ #{SRC_T} { items { label } } }", {}
    R.ok has_error(res, 'Unauthorized'), "expected Unauthorized, got #{errs_json res}"
    R.eq type(res.data[SRC_T]), 'cdata', "no data must be returned"

  R.it "real user with a session but no group -> Forbidden, no data", ->
    res = run_q "{ #{SRC_T} { items { label } } }", ctx_of actor_none
    R.ok has_error(res, 'Forbidden'), "expected Forbidden, got #{errs_json res}"
    R.eq type(res.data[SRC_T]), 'cdata', "no data must be returned"

  R.it "user with a read grant on the space -> data", ->
    res = run_q "{ #{SRC_T} { items { label } } }", ctx_of actor_src
    R.nok res.errors, errs_json res
    R.eq #res.data[SRC_T].items, 1
    R.eq res.data[SRC_T].items[1].label, 'src-row'

  R.it "member of the admin group -> data", ->
    res = run_q "{ #{SRC_T} { items { label } } }", admin_ctx
    R.nok res.errors, errs_json res
    R.eq #res.data[SRC_T].items, 1
    R.eq res.data[SRC_T].items[1].label, 'src-row'

  R.it "FK to a space without read -> field null, target data never leaked", ->
    res = run_q "{ #{SRC_T} { items { label tgt_id { nom } } } }", ctx_of actor_src
    R.nok res.errors, errs_json res
    item = res.data[SRC_T].items[1]
    R.eq type(item.tgt_id), 'cdata', "FK field must resolve to null"
    R.nok (leaks(res, 'secret-target')), "target record must not leak"

  R.it "back-reference to a space without read -> empty list", ->
    q = "{ #{TGT_T} { items { nom link_to_tgt { total items { label } } } } }"
    res = run_q q, ctx_of actor_tgt
    R.nok res.errors, errs_json res
    bk = res.data[TGT_T].items[1].link_to_tgt
    R.eq bk.total, 0, "back-reference must be empty"
    R.eq #bk.items, 0, "back-reference must be empty"
    R.nok (leaks(res, 'src-row')), "source records must not leak"

-- ── Cleanup ──────────────────────────────────────────────────────────────────

for a in *{ actor_none, actor_src, actor_tgt }
  auth.delete_session a.token
  box.space._tdb_users\delete a.user.id
auth.delete_session admin_sess.token
perms_mod.delete_group grp_src.id
perms_mod.delete_group grp_tgt.id
box.space._tdb_relations\delete rel_id
spaces_mod.delete_user_space SRC_NAME
spaces_mod.delete_user_space TGT_NAME
require('resolvers.init').reinit!
