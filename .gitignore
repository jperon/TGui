# Vendor bundles (large, regenerate with `make vendor`)
# Les bundles chargés par la page sont commités ; régénérer avec `make vendor`.
# Tout bundle chargé doit être commité, sinon un clone neuf le reçoit en 404
# (contrôlé par tests/js/test_vendor_bundles_tracked.coffee).
frontend/vendor/*
!frontend/vendor/tui-grid.bundle.*
!frontend/vendor/jsyaml.bundle.*
!frontend/vendor/codemirror.bundle.*
!frontend/vendor/sortablejs.bundle.*
!frontend/vendor/plugin-runtime.bundle.*
!frontend/vendor/wasmoon.bundle.*

# Docker data volumes
data/

# Node (if ever used for tooling)
node_modules/

# Playwright test artefacts (screenshots, videos, traces, last-run)
test-results/
playwright-report/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# PDF files (generated documentation)
*.pdf


# MoonScript native parser (compiled by make build, never committed)
build/

# direnv (Nix dev shell cache)
.direnv/
