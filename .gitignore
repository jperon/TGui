# Vendor bundles (large, regenerate with `make vendor`)
# Les bundles actifs (tui-grid, jsyaml) sont commités ; le reste est ignoré.
frontend/vendor/
!frontend/vendor/tui-grid.bundle.*
!frontend/vendor/jsyaml.bundle.*

# Docker data volumes
data/

# Node (if ever used for tooling)
node_modules/

# Playwright test artefacts (screenshots, videos, traces, last-run)
test-results/
playwright-report/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# PDF files (generated documentation)
*.pdf


# MoonScript native parser (compiled by make build, never committed)
build/
