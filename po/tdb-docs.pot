msgstr ""

#: doc/en/get-started.md:137 doc/en/reference.md:144
msgid "parts = {}"
msgstr ""

#: doc/en/get-started.md:138 doc/en/reference.md:145
msgid "table.insert(parts, @prenom) if @prenom and @prenom != \"\""
msgstr ""

#: doc/en/get-started.md:139 doc/en/reference.md:146
msgid "table.insert(parts, @particule) if @particule and @particule != \"\""
msgstr ""

#: doc/en/get-started.md:140 doc/en/reference.md:147
msgid "table.insert(parts, @nom) if @nom and @nom != \"\""
msgstr ""

#: doc/en/get-started.md:141 doc/en/reference.md:148
msgid "table.concat(parts, \" \")"
msgstr ""

#: doc/en/get-started.md:144
msgid "The `space` parameter gives access to records of another space (full scan):"
msgstr ""

#: doc/en/get-started.md:147 doc/en/reference.md:176
msgid "-- Count available copies for this book"
msgstr ""

#: doc/en/get-started.md:148 doc/en/reference.md:177
msgid "n = 0"
msgstr ""

#: doc/en/get-started.md:149 doc/en/reference.md:178
msgid "for e in *space(\"exemplaires\")"
msgstr ""

#: doc/en/get-started.md:150 doc/en/reference.md:179
msgid "  n += 1 if e.livre_id == @id and e.disponible"
msgstr ""

#: doc/en/get-started.md:151 doc/en/reference.md:180
msgid "n"
msgstr ""

#: doc/en/get-started.md:154
msgid "### Trigger formula ((trigger))"
msgstr ""

#: doc/en/get-started.md:156
msgid "Select **Trigger formula** and optionally list the trigger fields."
msgstr ""

#: doc/en/get-started.md:157
msgid "The formula is executed and the result **stored** on each creation or modification of the listed fields."
