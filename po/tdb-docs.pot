#: doc/en/reference.md:291
msgid "## 3. Relations"
msgstr ""

#: doc/en/reference.md:293
msgid "A **relation** links a field of a space (field of type `Relation`) to another space. It enables dependent filtering in custom views."
msgstr ""

#: doc/en/reference.md:295
msgid "**Recursive relations** (to the same space) are supported, for modeling tree structures (e.g., categories, genealogies)."
msgstr ""

#: doc/en/reference.md:300
msgid "# List relations of a space"
msgstr ""

#: doc/en/reference.md:302
msgid "  relations(spaceId: \"...\") {"
msgstr ""

#: doc/en/reference.md:303
msgid "    id name fromFieldId toSpaceId toFieldId reprFormula"
