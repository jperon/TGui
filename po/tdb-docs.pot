#: doc/en/reference.md:253
msgid "    name: \"cote_auto\", fieldType: String,"
msgstr ""

#: doc/en/reference.md:254
msgid "    formula: \"prefix = (@titre or \\\"\\\")\\\\upper!\\\\sub(1, 3)\\\\gsub(\\\"[^%A]\\\", \\\"\\\")\\nannee  = if @annee then tostring(@annee) else \\\"????\\\"\\n\\\"#{prefix}-#{annee}\\\"\","
msgstr ""

#: doc/en/reference.md:255
msgid "    triggerFields: [\"titre\", \"annee\"],"
msgstr ""

#: doc/en/reference.md:260
msgid "# Update an existing field"
msgstr ""

#: doc/en/reference.md:262
msgid "  updateField(fieldId: \"...\", input: {"
msgstr ""

#: doc/en/reference.md:263
msgid "    formula: \"self.prenom .. \\\" \\\" .. self.nom\","
msgstr ""

#: doc/en/reference.md:265
msgid "  }) { id name formula }"
msgstr ""

#: doc/en/reference.md:269
msgid "mutation { removeField(fieldId: \"...\") }"
msgstr ""

#: doc/en/reference.md:271
msgid "# Reorder"
msgstr ""

#: doc/en/reference.md:273
