#: doc/en/reference.md:332
msgid "    name: \"exemplaire_livre\","
msgstr ""

#: doc/en/reference.md:333
msgid "    fromSpaceId: \"exemplaires-id\","
msgstr ""

#: doc/en/reference.md:334
msgid "    fromFieldId: \"livre_id-field-id\","
msgstr ""

#: doc/en/reference.md:335
msgid "    toSpaceId:   \"livres-id\","
msgstr ""

#: doc/en/reference.md:341
msgid "mutation { deleteRelation(id: \"...\") }"
msgstr ""

#: doc/en/reference.md:343
msgid "# Set the display formula for a relation livres → auteurs"
