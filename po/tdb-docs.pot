#: doc/en/reference.md:1107
msgid "## 13. Applications (packaging and updates)"
msgstr ""

#: doc/en/reference.md:1109
msgid "TGui can package a whole application into a `.tdbapp.yaml` file, install it on another instance, and receive later versions while keeping local data and customisations. The walkthrough for an administrator is in [Quick Start](get-started.md)."
msgstr ""

#: doc/en/reference.md:1111
msgid "The header of a package is `app: {id, name, version, description}`; `version` is `x.y.z`. Elements are identified by stable keys (`space:<name>`, `field:<space>.<name>`, `view:<space>.<name>`, `page:<name>`, `dataview:<name>`, `plugin:<name>`, `group:<name>`, `perm:<group>|<type>|<resource>|<level>`, `seed:<space>|<value>`); a rename is declared with `renamed_from`."
msgstr ""

#: doc/en/reference.md:1116
msgid "# Installed applications"
msgstr ""

#: doc/en/reference.md:1117
msgid "query { listApps { appId name version activeCount obsoleteCount } }"
msgstr ""

#: doc/en/reference.md:1119
msgid "# Tracked items of one application"
msgstr ""

#: doc/en/reference.md:1120
msgid "query { appItems(appId: \"org.exemple.biblio\") { key type state version } }"
msgstr ""

#: doc/en/reference.md:1122
msgid "# Export a package (admin)"
msgstr ""

#: doc/en/reference.md:1124
msgid "  exportApp("
msgstr ""

#: doc/en/reference.md:1125
msgid "    meta: { id: \"org.exemple.biblio\", name: \"Library\", version: \"1.0.0\" },"
msgstr ""

#: doc/en/reference.md:1126
msgid "    seed: [{ space: \"livres\", keyField: \"isbn\" }]"
msgstr ""

#: doc/en/reference.md:1130
msgid "# Preview an install or update (read-only)"
msgstr ""

#: doc/en/reference.md:1132
msgid "  previewAppUpdate(yaml: \"...\") {"
msgstr ""

#: doc/en/reference.md:1133
msgid "    create { key type isCode }"
msgstr ""

#: doc/en/reference.md:1134
msgid "    update { key type isCode }"
msgstr ""

#: doc/en/reference.md:1135
msgid "    conflict { key type local delivered }"
msgstr ""

#: doc/en/reference.md:1136
msgid "    keepLocal { key type }"
msgstr ""

#: doc/en/reference.md:1137
msgid "    obsolete"
msgstr ""

#: doc/en/reference.md:1138
msgid "    rename { from to }"
msgstr ""

#: doc/en/reference.md:1139
msgid "    unchanged"
msgstr ""

#: doc/en/reference.md:1144
msgid "# Apply the update"
msgstr ""

#: doc/en/reference.md:1146
msgid "  applyAppUpdate(yaml: \"...\", decisions: [{ key: \"field:livres.titre\", choice: \"local\" }]) {"
msgstr ""

#: doc/en/reference.md:1147
msgid "    ok created updated kept unchanged obsolete skipped error"
msgstr ""

#: doc/en/reference.md:1151
msgid "# Preview and purge obsolete items"
msgstr ""

#: doc/en/reference.md:1153
msgid "  previewAppPurge(appId: \"org.exemple.biblio\", keys: [\"space:old\"]) {"
msgstr ""

#: doc/en/reference.md:1154
msgid "    losses { key type records fields relations views }"
msgstr ""

#: doc/en/reference.md:1155
msgid "    totalRecords"
msgstr ""

#: doc/en/reference.md:1159
msgid "  purgeAppObsolete(appId: \"org.exemple.biblio\", keys: [\"space:old\"], confirmed: true) {"
msgstr ""

#: doc/en/reference.md:1160
msgid "    ok purged error"
msgstr ""

#: doc/en/reference.md:1165
msgid "- `previewAppUpdate` and `previewAppPurge` never write."
msgstr ""

#: doc/en/reference.md:1166
msgid "- `applyAppUpdate` is atomic and requires a decision (`local` or `delivered`) for each conflict."
msgstr ""

#: doc/en/reference.md:1167
msgid "- `purgeAppObsolete` requires `confirmed: true` and only accepts items whose tracked state is obsolete."
msgstr ""

