#: doc/en/get-started.md:160 doc/en/reference.md:157
msgid "-- triggerFields: [\"titre\", \"annee\"]"
msgstr ""

#: doc/en/get-started.md:161 doc/en/reference.md:158
msgid "prefix = (@titre or \"\")\\upper!\\sub(1, 3)\\gsub(\"[^%A]\", \"\")"
msgstr ""

#: doc/en/get-started.md:162 doc/en/reference.md:159
msgid "annee  = if @annee then tostring(@annee) else \"????\""
msgstr ""

#: doc/en/get-started.md:163 doc/en/reference.md:160
msgid "\"#{prefix}-#{annee}\""
