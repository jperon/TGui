#: doc/en/reference.md:238 doc/en/reference.md:742 doc/en/reference.md:758
msgid "  }) { id name }"
msgstr ""

#: doc/en/reference.md:241
msgid "# Add a computed column"
msgstr ""

#: doc/en/reference.md:244
msgid "    name: \"nom_complet\", fieldType: String,"
msgstr ""

#: doc/en/reference.md:245
msgid "    formula: \"parts = {}\\ntable.insert(parts, @prenom) if @prenom and @prenom != \\\"\\\"\\ntable.insert(parts, @particule) if @particule and @particule != \\\"\\\"\\ntable.insert(parts, @nom) if @nom and @nom != \\\"\\\"\\ntable.concat(parts, \\\" \\\" )\","
msgstr ""

#: doc/en/reference.md:246 doc/en/reference.md:256
msgid "    language: \"moonscript\""
msgstr ""

#: doc/en/reference.md:247 doc/en/reference.md:257 doc/en/reference.md:315 doc/en/reference.md:326 doc/en/reference.md:337 doc/en/reference.md:671 doc/en/reference.md:848 doc/en/reference.md:903
msgid "  }) { id }"
msgstr ""

#: doc/en/reference.md:250
msgid "# Add a trigger formula (triggered on change of \"titre\" or \"annee\")"
