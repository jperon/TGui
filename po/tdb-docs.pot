#: doc/en/reference.md:307
msgid "# Create a relation livres → auteurs"
msgstr ""

#: doc/en/reference.md:309 doc/en/reference.md:320 doc/en/reference.md:331
msgid "  createRelation(input: {"
msgstr ""

#: doc/en/reference.md:310
msgid "    name: \"livre_auteur\","
msgstr ""

#: doc/en/reference.md:311 doc/en/reference.md:322
msgid "    fromSpaceId: \"livres-id\","
msgstr ""

#: doc/en/reference.md:312
msgid "    fromFieldId: \"auteur_id-field-id\","
msgstr ""

#: doc/en/reference.md:313
msgid "    toSpaceId:   \"auteurs-id\","
msgstr ""

#: doc/en/reference.md:314 doc/en/reference.md:325 doc/en/reference.md:336
msgid "    toFieldId:   \"id-field-id\""
